# Application
NODE_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_job_application_agent

# Auth (Phase 2). Use long random values in any shared or production environment.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend origin for CORS. Comma-separated if multiple.
CLIENT_URL=http://127.0.0.1:5173

# AI. Phase 1 does not call providers. Use mock for local/dev/tests.
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# File storage. Local filesystem in development.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Browser automation. Mock until Phase 9.
BROWSER_AUTOMATION_PROVIDER=mock

# Frontend
VITE_API_BASE_URL=
