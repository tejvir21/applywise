# Application
NODE_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_job_application_agent

# Auth (Phase 2). Use long random values in any shared or production environment.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Frontend origin for CORS. Comma-separated if multiple.
CLIENT_URL=http://127.0.0.1:5173

# AI. Phase 7 adds an Ollama provider; `mock` (deterministic templates from
# verified profile data only) remains the default. The core app works without
# any model running. No paid API is required.
# Ollama setup: install from https://ollama.com, then `ollama pull llama3.1:8b`
# (needs ~5GB disk and ~8GB RAM; any Ollama chat model works via OLLAMA_MODEL).
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
AI_TIMEOUT_MS=30000

# File storage. Local filesystem in development.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Browser automation. Mock until Phase 9.
BROWSER_AUTOMATION_PROVIDER=mock

# Frontend
VITE_API_BASE_URL=
