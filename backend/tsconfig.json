{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/jobs/AdzunaJobSource.ts",
    "src/jobs/CompanyBoardJobSource.ts",
    "src/jobs/JoobleJobSource.ts",
    "src/jobs/MuseJobSource.ts",
    "src/jobs/RemotiveJobSource.ts",
    "src/jobs/JobDiscoveryService.ts",
    "src/jobs/dedupes.ts",
    "src/jobs/freshness.ts",
    "src/jobs/geo.ts",
    "src/jobs/queryExpansion.ts",
    "src/jobs/relevance.ts",
    "src/jobs/discovery-types.ts",
    "src/jobs/jobFreshness.ts",
    "src/jobs/providerUtils.ts",
    "src/jobs/http.ts",
    "src/jobs/discovery",
    "src/services/JobDiscoveryService.ts",
    "src/services/dedupes.js",
    "src/services/freshness.js",
    "src/services/geo.js",
    "src/services/relevance.js",
    "src/services/queryExpansion.ts"
  ]
}