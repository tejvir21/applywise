# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=8000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_job_application_agent

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Frontend CORS
CLIENT_URL=http://127.0.0.1:5173

# AI Provider
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Job discovery (live search over authorized public job APIs).
# Company boards (Greenhouse/Lever/Ashby) and The Muse need NO credentials.
# Adzuna needs an app_id + app_key (free tier: https://developer.adzuna.com/).
# Remotive is a public API but may be blocked by network egress.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
REMOTIVE_ENABLED=true
# Optional: JSON array overriding the built-in company-board registry.
# Example: [{"company":"Groww","provider":"greenhouse","boardToken":"groww","enabled":true}]
COMPANY_BOARDS_JSON=
# Bounded discovery limits (never requests unbounded upstream pages).
DISCOVERY_MAX_QUERIES=6
DISCOVERY_MAX_PAGES_PER_SOURCE=2
DISCOVERY_MAX_RESULTS_PER_SOURCE=50
DISCOVERY_PAGE_SIZE=20
DISCOVERY_RELEVANCE_THRESHOLD=0.2
DISCOVERY_HTTP_CONCURRENCY=6
DISCOVERY_HTTP_TIMEOUT_MS=12000
DISCOVERY_RESULT_CACHE_MS=120000
DISCOVERY_HTTP_CACHE_TTL_MS=60000

# File storage. Supabase Storage is the preferred provider in production;
# local disk remains for development/tests and as an explicit fallback.
# STORAGE_PROVIDER=supabase requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# (server-side only, never expose to the frontend). The bucket must be private.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
# Explicit opt-in fallback for Supabase outages/misconfiguration: local|none.
# Local fallback is safe ONLY with persistent storage (see RESUME_STORAGE_PATH).
RESUME_STORAGE_FALLBACK=none
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_TIMEOUT_MS=8000
SUPABASE_MAX_RETRIES=2

# Browser automation
BROWSER_AUTOMATION_PROVIDER=mock

# Resume
MAX_RESUME_SIZE_MB=10
RESUME_STORAGE_PATH=./storage/uploads

# Rate limiting (per-user quotas for expensive endpoints)
RATE_LIMIT_AI_GENERATION_PER_MINUTE=10
RATE_LIMIT_RESUME_UPLOAD_PER_MINUTE=5
RATE_LIMIT_RESUME_ANALYSIS_PER_MINUTE=5
RATE_LIMIT_JOB_INGESTION_PER_MINUTE=10