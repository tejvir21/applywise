# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=8000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_job_application_agent

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Frontend CORS
CLIENT_URL=http://127.0.0.1:5173

# AI Provider
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# File storage. Supabase Storage is the preferred provider in production;
# local disk remains for development/tests and as an explicit fallback.
# STORAGE_PROVIDER=supabase requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# (server-side only, never expose to the frontend). The bucket must be private.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
# Explicit opt-in fallback for Supabase outages/misconfiguration: local|none.
# Local fallback is safe ONLY with persistent storage (see RESUME_STORAGE_PATH).
RESUME_STORAGE_FALLBACK=none
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_TIMEOUT_MS=8000
SUPABASE_MAX_RETRIES=2

# Browser automation
BROWSER_AUTOMATION_PROVIDER=mock

# Resume
MAX_RESUME_SIZE_MB=10
RESUME_STORAGE_PATH=./storage/uploads